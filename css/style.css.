
:root {
    --terracotta: #B65335;
    --orange: #E58A45;
    --red: #A9342B;
    --green: #596D45;
    --cream: #FFF7EC;
    --dark: #382B25;
    --white: #FFFFFF;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Georgia, serif;
    background: var(--cream);
    color: var(--dark);
    line-height: 1.6;
}

.header {
    background: var(--cream);
    padding: 20px 7%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 15px;
}

.logo {
    color: var(--terracotta);
    font-size: 27px;
    font-weight: bold;
    text-decoration: none;
}

nav {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
}

nav a {
    color: var(--dark);
    text-decoration: none;
    font-size: 14px;
}

nav a:hover {
    color: var(--terracotta);
}

.hero {
    min-height: 430px;
    padding: 80px 8%;
    display: flex;
    align-items: center;
    color: white;

    background:
        linear-gradient(
            90deg,
            rgba(55, 30, 20, .85),
            rgba(55, 30, 20, .15)
        ),
        url("../images/couverture/couverture.jpg")
        center/cover,
        var(--terracotta);
}

.hero-content {
    max-width: 600px;
}

.eyebrow {
    color: var(--orange);
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 2px;
}

.hero h1 {
    font-size: clamp(36px, 6vw, 64px);
    line-height: 1.1;
    margin: 20px 0;
}

.hero p {
    font-size: 18px;
    margin-bottom: 28px;
}

.main-button {
    display: inline-block;
    padding: 13px 23px;
    background: var(--orange);
    color: white;
    text-decoration: none;
    border-radius: 8px;
}

.welcome,
.tea-section {
    text-align: center;
    padding: 65px 8%;
}

.welcome h2,
.section-heading h2,
.tea-section h2,
.favorites h2 {
    font-size: 30px;
    color: var(--terracotta);
    margin: 10px 0;
}

.welcome p,
.tea-section p {
    max-width: 650px;
    margin: auto;
}

.recipe-section,
.favorites {
    padding: 45px 7%;
}

.section-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    flex-wrap: wrap;
    margin-bottom: 25px;
}

#recipe-count {
    color: var(--green);
}

#search {
    width: 100%;
    padding: 15px;
    border: 1px solid #E4D3C5;
    border-radius: 9px;
    font-size: 15px;
    margin-bottom: 20px;
    background: white;
}

.filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 25px;
}

.filter {
    border: 1px solid var(--terracotta);
    color: var(--terracotta);
    background: transparent;
    padding: 9px 16px;
    border-radius: 25px;
    cursor: pointer;
}

.filter.active,
.filter:hover {
    background: var(--terracotta);
    color: white;
}

.recipe-grid {
    display: grid;
    grid-template-columns:
        repeat(auto-fill, minmax(220px, 1fr));
    gap: 23px;
}

.recipe-card {
    background: white;
    border-radius: 13px;
    overflow: hidden;
    box-shadow: 0 4px 15px #0000000d;
}

.recipe-card img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    background: #E8D7C8;
}

.recipe-info {
    padding: 17px;
}

.recipe-info h3 {
    color: var(--terracotta);
    margin-bottom: 7px;
}

.recipe-info p {
    font-size: 14px;
}

.recipe-meta {
    color: var(--green);
    font-size: 12px;
    margin: 10px 0;
}

.favorite-button {
    border: none;
    background: #F9E9DF;
    color: var(--red);
    border-radius: 7px;
    padding: 8px 12px;
    cursor: pointer;
}

.tea-section {
    background: #E8EBD9;
}

footer {
    background: var(--dark);
    color: white;
    text-align: center;
    padding: 35px;
}

footer h2 {
    color: var(--orange);
    margin-bottom: 8px;
}

.empty-message {
    padding: 25px;
    text-align: center;
    grid-column: 1 / -1;
}

@media (max-width: 600px) {
    .header {
        justify-content: center;
    }

    nav {
        justify-content: center;
        gap: 12px;
    }

    .hero {
        min-height: 360px;
        padding: 50px 7%;
    }

    .recipe-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .recipe-card img {
        height: 135px;
    }

    .recipe-info {
        padding: 12px;
    }

    .recipe-info h3 {
        font-size: 15px;
    }
}

